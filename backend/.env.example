# Local dev defaults. Copy to .env and adjust.
#
# Legend:
#   [COMPULSORY] must be set for the app to run
#   [OPTIONAL]   has a safe default; only set to change behavior
#   [IGNORE]     do NOT set here — auto-managed or not applicable
#
# On Render all of these are service env vars (see render.yaml /
# .env.render.example in the repo root) — Render injects PORT itself, so it
# is NOT declared there.

# [COMPULSORY]  Postgres connection string (dev docker-compose listens on :5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kingfisher

# [OPTIONAL]    Dev default is accepted; must be changed in production
# (ENVIRONMENT=production + non-default SECRET_KEY or startup fails).
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
INITIAL_ADMIN_EMAIL=
DEFAULT_MAX_LISTS=30

# [IGNORE]      PORT — only consumed by the Dockerfile's uvicorn CMD (dev runs
# uvicorn directly); leave unset here.
