# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Never commit the real .env — it's gitignored.
#
# Legend:
#   [COMPULSORY] must be set for the stack to start
#   [OPTIONAL]   has a safe default; only set to change behavior
#   [IGNORE]     do NOT set — auto-managed or not applicable
#
# Deploying on Render instead? Render doesn't use this file — see
# render.yaml + .env.render.example for the Render-specific variables.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# [COMPULSORY]  Database password for the db container (compose refuses to
# start without it — same for SECRET_KEY).
POSTGRES_PASSWORD=

# [COMPULSORY]  JWT signing secret. Must differ from "change-me-in-production"
# or the backend refuses to boot in production mode.
SECRET_KEY=

# [COMPULSORY]  Your real domain, e.g. kingfisher.example.com — Caddy
# auto-provisions HTTPS via Let's Encrypt for real domains. Leave localhost
# only for local/LAN testing (plain HTTP, no cert).
DOMAIN=localhost

# [COMPULSORY]  Comma-separated origins allowed to call the API. Should match
# DOMAIN above (with scheme) once you have a real domain.
CORS_ORIGINS=http://localhost

# [OPTIONAL]    Promote this email to admin on backend startup once that
# account has registered (see kingfisher-backend/docs/DATABASE.md).
INITIAL_ADMIN_EMAIL=

# [OPTIONAL]    Default owned-list quota (created + forked) for newly
# registered users. Admins can override it per user from the Admin page.
DEFAULT_MAX_LISTS=30

# [OPTIONAL]    JWT knobs — the defaults are good; only set these to change them.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# [IGNORE]      PORT — the compose edge Caddy always proxies to backend:8000,
# so keep this at the default unless you also change docker-compose.prod.yml.
# PORT=8000
