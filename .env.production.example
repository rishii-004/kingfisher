# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Never commit the real .env — it's gitignored.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
SECRET_KEY=

# Your real domain, e.g. kingfisher.example.com — Caddy auto-provisions
# HTTPS via Let's Encrypt for real domains. Leave as localhost for
# local/LAN testing (plain HTTP, no cert).
DOMAIN=localhost

# Comma-separated origins allowed to call the API. Should match DOMAIN
# above (with scheme) once you have a real domain.
CORS_ORIGINS=http://localhost

# Optional: promote this email to admin on backend startup once that
# account has registered (see kingfisher-backend/docs/DATABASE.md).
INITIAL_ADMIN_EMAIL=

# Default owned-list quota (created + forked) for newly registered users.
# Admins can override it per user from the Admin page; ignored for admins.
DEFAULT_MAX_LISTS=30
