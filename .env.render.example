# kingfisher — Render environment variables
#
# Render Blueprints don't read a .env file. Every variable below is declared
# in render.yaml and its value is set in the Render dashboard (or prompted for
# at Blueprint creation). This file is a fill-in-the-blanks checklist.
#
# Legend:
#   [COMPULSORY] must be set for the app to work
#   [OPTIONAL]   has a safe default; only set to change behavior
#   [IGNORE]     do NOT set — auto-managed or not applicable
#
# Do NOT commit real values. Never paste a real SECRET_KEY or DB password into
# a committed file.

# ---------------------------------------------------------------------------
# Backend service (kingfisher-api)
# ---------------------------------------------------------------------------

# [COMPULSORY]  Database. Supabase → Project Settings → Database → Connection
# string → "Session pooler" → URI, then append ?sslmode=require.
# Copy the URI wholesale (password must stay URL-encoded), e.g.:
#   postgresql://postgres.<project-ref>:<encoded-pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Pasting this into the Blueprint prompt sets DATABASE_URL.
# DATABASE_URL=

# [COMPULSORY]  JWT signing secret. Render generates one at Blueprint
# creation (generateValue: true) — you only set it if you rotate it later.
# Must differ from "change-me-in-production" or startup fails (ENVIRONMENT=production).
# SECRET_KEY=

# [COMPULSORY]  Toggles the SECRET_KEY guard (app/config.py). Keep "production".
ENVIRONMENT=production

# [OPTIONAL]    Allowed API origins (comma-separated) — only needed if the API
# is ever called DIRECTLY cross-origin (e.g. hitting kingfisher-api.onrender.com
# from a page on another origin, or the Render dashboard's API tester).
# Normal app traffic never triggers CORS: the frontend's Caddy proxies /api/*
# to the backend server-side, so the browser only talks to the frontend origin.
# Recommended safety net: set it to the frontend's origin (with scheme), e.g.
# https://kingfisher-app.onrender.com
# CORS_ORIGINS=

# [OPTIONAL]    Promote this registered email to admin on every backend boot.
# Register the account first, then set this and restart the backend.
INITIAL_ADMIN_EMAIL=

# [OPTIONAL]    Default owned-list quota (created + forked) for new users.
DEFAULT_MAX_LISTS=30

# [OPTIONAL]    JWT knobs — defaults are good; only set to change them.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# [IGNORE]      PORT — Render injects it (default 10000) and routes traffic to
# it; the backend Dockerfile already listens on $PORT. Do NOT set it here.

# ---------------------------------------------------------------------------
# Frontend service (kingfisher-app)
# ---------------------------------------------------------------------------

# [COMPULSORY]  The backend's public URL; Caddy reverse-proxies /api/* to it.
# e.g. https://kingfisher-api.onrender.com
# BACKEND_URL=

# [IGNORE]      PORT — Render injects it for the frontend too; Caddy listens
# on $PORT. Do NOT set it here.

# ---------------------------------------------------------------------------
# Not applicable on Render / Supabase
# ---------------------------------------------------------------------------

# [IGNORE]      POSTGRES_PASSWORD / POSTGRES_USER / POSTGRES_DB — only used by
# the local docker-compose stacks (see .env.production.example for those).
